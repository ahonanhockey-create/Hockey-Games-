<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NHL Central - Penalty Shootout Game</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Navigation Menu -->
    <nav class="navbar">
        <a href="index.html">Schedule & Scores</a>
        <a href="teams.html">Standings</a>
        <a href="game.html" class="active">🏒 Penalty Shootout Game</a>
    </nav>

    <header>
        <h1>Interactive Penalty Shootout 🥅</h1>
        <p>Take a shot against the AI goaltender! Can you score?</p>
    </header>

    <main class="container">
        <div class="scoreboard">
            <p>Score: <span id="goalScore">0</span> / <span id="totalShots">0</span></p>
        </div>

        <div id="rink-view" style="font-size: 50px; margin: 20px;">
            🏒 🥅
        </div>

        <p id="gameMessage" style="font-size: 18px; font-weight: bold; min-height: 30px;">Choose where to shoot!</p>

        <div class="game-controls">
            <button class="shot-btn" data-spot="left">Shoot Left ⬅️</button>
            <button class="shot-btn" data-spot="center">Shoot Center ⬆️</button>
            <button class="shot-btn" data-spot="right">Shoot Right ➡️</button>
        </div>

        <div style="margin-top: 20px;">
            <button id="resetGameBtn" style="background-color: #ff6b6b;">Reset Game</button>
        </div>
    </main>

    <footer>
        <p>&copy; 2026 NHL Score Central. Built with Vibe Coding.</p>
    </footer>

    <script src="script.js"></script>
</body>
</html>
