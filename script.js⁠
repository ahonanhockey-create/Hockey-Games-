// =========================================================
// Feature 1: Hot Streak Waiver Wire Advisor (index.html)
// =========================================================
const streakBtn = document.getElementById("streakBtn");
const hotStreakStatus = document.getElementById("hotStreakStatus");

const waiverPicks = [
    "🔥 Sam Reinhart (F) - On fire with goals in consecutive games! High power-play usage.",
    "🔥 Seth Jarvis (F) - Logging big minutes and racking up assists.",
    "🔥 Lukas Dostal (G) - Stealing starts and putting up high save percentage numbers."
];

if (streakBtn) {
    streakBtn.addEventListener("click", function() {
        const randomIndex = Math.floor(Math.random() * waiverPicks.length);
        hotStreakStatus.textContent = waiverPicks[randomIndex];
        hotStreakStatus.style.color = "#90e0ef";
        hotStreakStatus.style.fontWeight = "bold";
    });
}

// =========================================================
// Feature 2: Player Database Search & Info Lookup (teams.html)
// =========================================================
const searchPlayerBtn = document.getElementById("searchPlayerBtn");
const playerSearchInput = document.getElementById("playerSearchInput");
const playerSearchOutput = document.getElementById("playerSearchOutput");

if (searchPlayerBtn) {
    searchPlayerBtn.addEventListener("click", function() {
        const query = playerSearchInput.value.trim();

        if (query === "") {
            playerSearchOutput.textContent = "Please type a player name to search.";
            playerSearchOutput.style.color = "#ff6b6b";
        } else {
            playerSearchOutput.textContent = `✅ Player Profile Found for "${query}": Active Tier-1 Starter | High projected fantasy point ceiling this week!`;
            playerSearchOutput.style.color = "#00b4d8";
        }
    });
}

// =========================================================
// Feature 3: Matchup Win Simulator & Record Counter (schedule.html)
// =========================================================
const simulateWinBtn = document.getElementById("simulateWinBtn");
const winsCount = document.getElementById("winsCount");
let currentWins = 14;

if (simulateWinBtn) {
    simulateWinBtn.addEventListener("click", function() {
        currentWins++;
        winsCount.textContent = currentWins;
        simulateWinBtn.textContent = "Win Recorded! 🎉";
        simulateWinBtn.style.backgroundColor = "#28a745";
        
        setTimeout(() => {
            simulateWinBtn.textContent = "Simulate Next Win! 🎉";
            simulateWinBtn.style.backgroundColor = "#00b4d8";
        }, 1500);
    });
}
