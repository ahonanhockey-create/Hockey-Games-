        ingredients: "Raw Apple, Dietary Fiber, Vitamin C, Polyphenols",
        rating: "9.5/10 (Superfood)",
        verdict: "Natural fiber slows down sugar absorption, promoting digestive health."
    }
];

const searchBtn = document.getElementById("searchBtn");
const searchInput = document.getElementById("searchInput");
const searchResult = document.getElementById("searchResult");

if (searchBtn) {
    searchBtn.addEventListener("click", function() {
        const query = searchInput.value.trim().toLowerCase();
        
        // Find matching item in database
        const match = database.find(item => item.name === query);

        if (match) {
            document.getElementById("resName").textContent = `${match.name.toUpperCase()} (${match.type})`;
            document.getElementById("resCalories").textContent = match.calories;
            document.getElementById("resSugar").textContent = match.sugar;
            document.getElementById("resIngredients").textContent = match.ingredients;
            document.getElementById("resRating").textContent = match.rating;
            document.getElementById("resVerdict").textContent = match.verdict;
            searchResult.style.display = "block";
        } else if (query === "") {
            alert("Please type a food or drink item to search!");
        } else {
            // General response for unlisted items using conditional logic
            document.getElementById("resName").textContent = query.toUpperCase();
            document.getElementById("resCalories").textContent = "Approx. 150-250 kcal";
            document.getElementById("resSugar").textContent = "Varies based on brand";
            document.getElementById("resIngredients").textContent = "Standard commercial processing ingredients";
            document.getElementById("resRating").textContent = "5/10 (Moderate)";
            document.getElementById("resVerdict").textContent = "Check packaging labels for artificial dyes and added sugars.";
            searchResult.style.display = "block";
        }
    });
}
