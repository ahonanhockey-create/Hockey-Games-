    {
        name: "soda",
        type: "Drink",
        calories: "140 kcal",
        sugar: "39 grams",
        ingredients: "Carbonated Water, High Fructose Corn Syrup, Caramel Color, Phosphoric Acid",
        rating: "2/10 (Unhealthy)",
        verdict: "High fructose corn syrup causes sudden insulin spikes and metabolic stress."
    },
    {
        name: "water",
        type: "Drink",
        calories: "0 kcal",
        sugar: "0 grams",
        ingredients: "Purified Water, Natural Minerals",
        rating: "10/10 (Optimal)",
        verdict: "Essential for human cellular function and optimal hydration."
    },
    {
        name: "chips",
        type: "Food",
        calories: "160 kcal per serving",
        sugar: "1 gram",
        ingredients: "Potatoes, Vegetable Oil, TBHQ Preservative, Excessive Salt",
