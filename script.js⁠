// Helper Function to Perform Search
function performSearch(query) {
    const searchResult = document.getElementById("searchResult");
    const resName = document.getElementById("resName");
    const resCalories = document.getElementById("resCalories");
    const resSugar = document.getElementById("resSugar");
    const resIngredients = document.getElementById("resIngredients");
    const resRating = document.getElementById("resRating");
    const resVerdict = document.getElementById("resVerdict");

    if (!query) {
        alert("Please enter a food or drink item to inspect!");
        return;
    }

    const match = database.find(item => item.name === query.toLowerCase());

    if (match) {
        resName.textContent = `${match.name.toUpperCase()} (${match.type})`;
        resCalories.textContent = match.calories;
        resSugar.textContent = match.sugar;
        resIngredients.textContent = match.ingredients;
        resRating.textContent = match.rating;
        resVerdict.textContent = match.verdict;
    } else {
        // Fallback result using conditional handling for unlisted items
        resName.textContent = `${query.toUpperCase()} (Unlisted Item)`;
        resCalories.textContent = "Approx. 150 - 250 kcal";
        resSugar.textContent = "Check packaging details";
        resIngredients.textContent = "Standard processed commercial ingredients";
        resRating.textContent = "5/10 (Moderate)";
        resVerdict.textContent = "Always check nutrition labels for artificial dyes, additives, and added sugars.";
    }

    // Show result card
    searchResult.classList.remove("hidden");
}

// Event Listeners setup when DOM is fully loaded
document.addEventListener("DOMContentLoaded", function() {
    const searchBtn = document.getElementById("searchBtn");
    const searchInput = document.getElementById("searchInput");
    const tagButtons = document.querySelectorAll(".tag-btn");

    if (searchBtn && searchInput) {
        // Click event on Search Button
        searchBtn.addEventListener("click", function() {
            performSearch(searchInput.value.trim());
        });

        // Press Enter key to search
        searchInput.addEventListener("keypress", function(e) {
            if (e.key === "Enter") {
                performSearch(searchInput.value.trim());
            }
        });
    }

    // Quick tag button clicks
    tagButtons.forEach(btn => {
        btn.addEventListener("click", function() {
            const tagQuery = this.getAttribute("data-query");
            if (searchInput) {
                searchInput.value = tagQuery;
            }
            performSearch(tagQuery);
        });
    });
});
